# Copy to .env.local for local dev. Real values go in Vercel and the Claude Code
# cloud environment settings — never commit them.

# --- Supabase ---
# For local dev, `pnpm db:start` prints a local URL and keys (http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Model provider (OpenAI-compatible: DeepInfra or OpenRouter) ---
AI_BASE_URL=https://api.deepinfra.com/v1/openai
AI_API_KEY=
# Exact model id as listed by your provider (default plan: DeepSeek V4 Flash)
AI_MODEL=
# Used in demo mode or when the main model is slow
AI_FALLBACK_MODEL=
# Set to true if the provider/model supports response_format json_schema;
# otherwise labels use json_object mode with the schema in the prompt.
AI_STRUCTURED_OUTPUTS=false
# Notes search. Must return 1024 dimensions (material_chunks.embedding),
# e.g. BAAI/bge-m3 on DeepInfra. Without it, search falls back to keywords.
EMBEDDING_MODEL=
# Optional: a different provider for embeddings (defaults to AI_BASE_URL / AI_API_KEY)
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SAGE_RATE_LIMIT_PER_HOUR=60
# Shown by Sage when a student may be in distress (until institutions have their own setting)
SAGE_COUNSELLING_CONTACT=
DEMO_MODE=false
# Vercel cron sends it as a Bearer token to /api/cron/weekly-metrics (nightly
# Reliance Score refresh). Any long random string.
CRON_SECRET=

# --- Scripts ---
# Password for users created by `pnpm seed` (existing users keep theirs).
# Defaults to safesight-demo against a local Supabase; on a hosted project,
# new users get a random password when it is unset.
SEED_PASSWORD=
# `pnpm db:push:hosted` applies supabase/migrations through the Management API.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
