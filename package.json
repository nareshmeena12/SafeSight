{
  "name": "safesight",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.mts",
    "metrics": "tsx scripts/refresh-metrics.mts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:push:hosted": "tsx scripts/db-push-hosted.mts",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts && sed -i '1i // Generated by `pnpm db:types` (supabase gen types). Do not edit by hand.' src/lib/supabase/database.types.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.70",
    "@ai-sdk/react": "^4.0.146",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "ai": "^7.0.142",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
